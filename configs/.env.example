# Environment Variables Template
# Copy this to .env and fill in your values

# General Settings
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=info

# Application Settings
NODE_ENV=development
APP_PORT=3000

# PostgreSQL Database Configuration
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Nginx Configuration
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Service Configuration
# Add your service-specific environment variables here
# API_KEY=your_api_key_here
# DATABASE_URL=postgresql://appuser:CHANGE_THIS_PASSWORD@postgres:5432/appdb

# Docker Configuration
COMPOSE_PROJECT_NAME=server-layer
COMPOSE_FILE=docker-compose.yml

# Volume Paths
VOLUMES_BASE_PATH=../volumes

# Logging Configuration
LOGGING_DRIVER=json-file
LOGGING_MAX_SIZE=10m
LOGGING_MAX_FILE=3
