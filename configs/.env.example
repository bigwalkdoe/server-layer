# Environment Variables Template
#
# Copy this file to configs/.env and fill in the required values:
#
#     cp configs/.env.example configs/.env
#
# Compose reads configs/.env automatically. Do not commit the real .env file.
#
# Every variable here is actually consumed by docker-compose.yml. Anything not
# listed is not read by the stack.

# --- Required ---------------------------------------------------------------
# There are no defaults for these on purpose: `docker compose up` fails with an
# explanatory error rather than starting a database or cache with a password
# that everyone knows. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Optional ---------------------------------------------------------------

# Database name and user created on first start.
POSTGRES_DB=appdb
POSTGRES_USER=appuser

# Host ports. Database and cache ports are bound to 127.0.0.1 only; the web
# server is reachable on all interfaces, over HTTP and HTTPS.
NGINX_HTTP_PORT=8081
NGINX_HTTPS_PORT=8443
POSTGRES_PORT=5435
REDIS_PORT=6379
OLLAMA_PORT=11434

# Seconds that /api/data keeps a generated payload in Redis.
CACHE_TTL_SECONDS=30
